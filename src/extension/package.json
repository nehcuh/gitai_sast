{
  "name": "gitai-sast",
  "displayName": "GitAI SAST",
  "description": "AI-powered static code analysis for VSCode",
  "version": "0.1.27",
  "publisher": "gitai",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitai.sast.scan",
    "onCommand:gitai.sast.scanWorkspace",
    "onCommand:gitai.sast.showResults",
    "onCommand:gitai.sast.aiFix",
    "onCommand:gitai.sast.restartLsp",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:rust"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitai.sast.scan",
        "title": "Scan Current File",
        "category": "GitAI SAST"
      },
      {
        "command": "gitai.sast.scanWorkspace",
        "title": "Scan Workspace",
        "category": "GitAI SAST"
      },
      {
        "command": "gitai.sast.showResults",
        "title": "Show Scan Results",
        "category": "GitAI SAST"
      },
      {
        "command": "gitai.sast.aiFix",
        "title": "AI Fix Vulnerability",
        "category": "GitAI SAST"
      },
      {
        "command": "gitai.sast.restartLsp",
        "title": "Restart Opengrep LSP",
        "category": "GitAI SAST"
      }
    ],
    "chatParticipants": [
      {
        "id": "gitai.sast.chatParticipant",
        "name": "sast",
        "description": "Security analysis and AI fixes",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain vulnerabilities in detail"
          },
          {
            "name": "fix",
            "description": "Generate AI-powered fixes"
          },
          {
            "name": "taint",
            "description": "Show taint analysis paths"
          },
          {
            "name": "scan",
            "description": "Scan current file or workspace"
          }
        ]
      }
    ],
    "configuration": {
      "title": "GitAI SAST",
      "properties": {
        "gitai.sast.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to MCP Server binary"
        },
        "gitai.sast.opengrepPath": {
          "type": "string",
          "default": "",
          "description": "Path to Opengrep binary (empty: use PATH or cached version)"
        },
        "gitai.sast.opengrepRules": {
          "type": "string",
          "default": "",
          "description": "Path to Opengrep rules directory or YAML file (empty: use default 'auto' config)"
        },
        "gitai.sast.severityThreshold": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "medium",
          "description": "Minimum severity level to report"
        },
        "gitai.sast.enableAutoScan": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic scanning on file save"
        },
        "gitai.sast.scannerProvider": {
          "type": "string",
          "enum": [
            "local",
            "remote",
            "both"
          ],
          "default": "local",
          "description": "Select scanner engine: 'local' (Opengrep binary), 'remote' (Enterprise SAST), or 'both'."
        },
        "gitai.sast.scanMode": {
          "type": "string",
          "enum": [
            "workspace",
            "currentFile"
          ],
          "default": "currentFile",
          "description": "Scope of background scanning: 'currentFile' (scan only active file), 'workspace' (scan entire workspace)."
        },
        "gitai.sast.remoteUrl": {
          "type": "string",
          "default": "",
          "description": "Remote SAST API URL"
        },
        "gitai.sast.remoteUserId": {
          "type": "string",
          "default": "",
          "description": "Remote SAST user id"
        },
        "gitai.sast.remoteAllowInsecureTls": {
          "type": "boolean",
          "default": false,
          "description": "Allow invalid TLS certificates for remote SAST endpoints (insecure; use only in trusted networks)."
        },
        "gitai.sast.remoteCaCertPath": {
          "type": "string",
          "default": "",
          "description": "Optional PEM file path for custom CA certificate used to validate remote SAST HTTPS."
        },
        "gitai.sast.ai.provider": {
          "type": "string",
          "enum": [
            "auto",
            "disabled",
            "vscode",
            "openaiCompatible",
            "copilotAgent"
          ],
          "default": "auto",
          "description": "AI provider for fix suggestions (auto-detect, disabled, VS Code built-in models, OpenAI-compatible API, or Copilot Agent)"
        },
        "gitai.sast.ai.autoDetectPriority": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "copilotAgent",
              "vscode",
              "openaiCompatible"
            ]
          },
          "default": [
            "copilotAgent",
            "vscode",
            "openaiCompatible"
          ],
          "description": "Priority order for auto-detecting AI providers (used when gitai.sast.ai.provider=auto)"
        },
        "gitai.sast.ai.apiUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible chat completions endpoint URL (used when gitai.sast.ai.provider=openaiCompatible)"
        },
        "gitai.sast.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI-compatible endpoint (used when gitai.sast.ai.provider=openaiCompatible)"
        },
        "gitai.sast.ai.modelName": {
          "type": "string",
          "default": "",
          "description": "Model name for OpenAI-compatible endpoint (used when gitai.sast.ai.provider=openaiCompatible)"
        },
        "gitai.sast.ai.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for OpenAI-compatible endpoint (used when gitai.sast.ai.provider=openaiCompatible)"
        },
        "gitai.sast.ai.requestTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Request timeout in milliseconds for OpenAI-compatible endpoint"
        },
        "gitai.sast.ai.stream": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming AI fixes (OpenAI-compatible: request stream; UI: show a live Markdown preview)."
        },
        "gitai.sast.ai.enableThinking": {
          "type": "boolean",
          "default": false,
          "description": "Enable longer reasoning/explanations in AI outputs (may be slower)."
        },
        "gitai.sast.ai.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "Override system prompt (empty uses built-in prompt)"
        },
        "gitai.sast.ai.userPromptTemplate": {
          "type": "string",
          "default": "",
          "description": "Override user prompt template (supports {rule_id}, {severity}, {title}, {description}, {code_snippet}, {context})"
        },
        "gitai.sast.ai.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log AI request/response details to 'GitAI SAST' Output channel (may include code snippets)."
        },
        "gitai.sast.ai.debugMaxChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Max characters per logged AI prompt/response segment."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.45.0",
    "ncp": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "uuid": "^9.0.0",
    "vscode-languageclient": "^9.0.1"
  }
}